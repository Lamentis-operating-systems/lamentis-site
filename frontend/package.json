{
  "name": "frontend",
  "version": "0.0.2",
  "private": true,
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": "24.x",
    "npm": ">=11.6.4 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.6.4 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "postinstall": "node scripts/apply-brace-expansion-compat.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dead-code": "knip",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:cross-browser": "npm run build && npm run test:e2e:cross-browser:run",
    "test:e2e:cross-browser:run": "playwright test --browser=all --project=firefox --project=webkit --grep @cross-browser-smoke",
    "test:e2e:dev": "PLAYWRIGHT_DEV_SERVER=1 playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "verify": "npm run lint && npm run lint:css && npm run typecheck && npm run check:dead-code && npm run test && npm run build"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.8.13",
    "negotiator": "1.0.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.61.1"
    },
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "postcss@8.4.31": "8.5.25",
    "sharp@0.34.5": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/negotiator": "0.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "brace-expansion": "5.0.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "knip": "6.27.0",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "typescript": "7.0.2",
    "vitest": "4.1.7"
  }
}
