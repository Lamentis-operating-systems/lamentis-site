{
  "name": "frontend",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dead-code": "knip",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify": "npm run lint && npm run lint:css && npm run typecheck && npm run check:dead-code && npm run test && npm run build"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.8.13",
    "negotiator": "1.0.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/negotiator": "0.6.4",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "knip": "6.27.0",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
